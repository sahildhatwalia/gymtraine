{
  "name": "ai-fitness-coach-server",
  "version": "1.0.0",
  "description": "Express + MongoDB backend. Also serves the built React client in production.",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",

    "install:client": "npm --prefix ../client install",
    "build:client": "npm --prefix ../client run build",

    "deploy": "npm install && npm run install:client && npm run build:client && npm run start"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "groq-sdk": "^1.1.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
