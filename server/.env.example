# ─── Server Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# ── MongoDB ──────────────────────────────────────────────────────────────────────
# Local:       mongodb://localhost:27017/ai-fitness-coach
# Atlas (prod): mongodb+srv://<user>:<password>@cluster.mongodb.net/ai-fitness-coach
MONGO_URI=mongodb://localhost:27017/ai-fitness-coach

# ── Auth ─────────────────────────────────────────────────────────────────────────
# Change this to a long, random secret in production
JWT_SECRET=replace_with_a_strong_random_secret

# ── AI / Groq ────────────────────────────────────────────────────────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────────
PORT=5000

# ── CORS ─────────────────────────────────────────────────────────────────────────
# In production, set this to your deployed client URL (no trailing slash)
# Example: https://your-client.vercel.app
# Leave empty in development (all origins allowed for convenience)
CLIENT_URL=
