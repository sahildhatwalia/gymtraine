# ─── Client Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# ── API ─────────────────────────────────────────────────────────────────────────
# In development: Leave empty — Vite's proxy routes /api → http://localhost:5000
# In production:  Set this to your deployed server URL (no trailing slash)
# Example: https://your-server.onrender.com
VITE_API_URL=
